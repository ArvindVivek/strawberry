# Copy to .env.local (gitignored). Every value is optional: without a key, "Triage with AI"
# answers with Strawberry's built-in rules and says AI triage is off.

# Server only. Claude is tried first, OpenAI is the fallback. Copy without printing them (and
# never for tests; they mock the providers and e2e refuses to run with either key set):
#   grep -E '^(ANTHROPIC|OPENAI)_API_KEY=' "/Users/arvind/Documents/Kitchen Labs/kitchenlabs-kit/.env" >> .env.local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
